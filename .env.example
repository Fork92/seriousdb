# Copy this file to `.env` and adjust values for local development:
#
#   cp .env.example .env
#
# The real `.env` file is listed in `.gitignore` and must never be committed.

# Path to the on-disk database file.
SERIOUSDB_DB_FILE=.sdb

# Time to sync the in memory DB with SERIOUSDB_DB_FILE in seconds after last change
SERIOUSDB_DB_SYNC_INTERVAL=1.0

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SERIOUSDB_LOG_LEVEL=INFO

# Host IP where the API is running.
SERIOUSDB_HOST=127.0.0.1

# Host port which is used by the API.
SERIOUSDB_PORT=8000